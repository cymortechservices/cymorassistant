# CYMOR ASSISTANT — environment variables (names only; NEVER commit a real .env)
# Copy this file to .env (in the backend/ folder) and fill in the values.
# On Heroku, set the same names as Config Vars instead.

PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (include the database name)
MONGODB_URI=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Owner's WhatsApp number, international format, digits only (e.g. 2547XXXXXXXX)
OWNER_PHONE_NUMBER=

# Random secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 64 hex characters. Encrypts the stored WhatsApp session. Back it up safely.
# For rotation, list several keys separated by commas: newest first.
SESSION_ENCRYPTION_KEY=

# Dashboard login. Create the hash with:  npm run hash -- "your strong password"
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=

# Public URL of the dashboard (used for CORS), e.g. https://your-app.herokuapp.com
APP_BASE_URL=

# Initial values (afterwards controlled from the dashboard / WhatsApp commands)
ASSISTANT_ENABLED=false
NOTIFICATION_ENABLED=true
TIMEZONE=Africa/Nairobi

# Optional
# SESSION_ID=primary
# LOG_LEVEL=info
